{
  "name": "lakehouse-cloud-control",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.22.3 <25"
  },
  "scripts": {
    "typecheck": "cf workers types && tsc --noEmit && tsc --noEmit -p tsconfig.browser.json",
    "build": "cf build",
    "test": "node --check src/ui/client.js && vitest run",
    "format:check": "prettier --check src tests *.ts tsconfig*.json package.json",
    "dev": "cf dev",
    "test:browser": "playwright test"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.v.17",
    "@cloudflare/vitest-plugin": "1.8.2",
    "@playwright/test": "1.65.0",
    "@types/node": "24.19.2",
    "cf": "1.0.0-beta.32",
    "prettier": "3.10.1",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "jose": "6.2.17",
    "zod": "4.6.7"
  }
}
