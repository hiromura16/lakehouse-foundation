{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "types": [
      "./.cloudflare/types/index.d.ts",
      "@cloudflare/vitest-plugin/types"
    ]
  },
  "include": ["src/**/*.ts", "tests/control.test.ts"]
}
