{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [":dependencyDashboard"],
  "enabledManagers": ["github-actions", "custom.regex"],
  "automerge": false,
  "prConcurrentLimit": 3,
  "prHourlyLimit": 2,
  "github-actions": {
    "pinDigests": true
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github\\/workflows\\/renovate\\.yml$/"],
      "matchStrings": [
        "RENOVATE_IMAGE: (?<depName>ghcr\\.io/renovatebot/renovate):(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "matchManagers": ["github-actions"],
      "matchDepTypes": ["!action", "!workflow"],
      "enabled": false
    },
    {
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    }
  ]
}
