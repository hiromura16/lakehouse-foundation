{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [":dependencyDashboard"],
  "enabledManagers": ["github-actions", "custom.regex", "pip-compile"],
  "automerge": false,
  "automergeType": "pr",
  "automergeStrategy": "squash",
  "platformAutomerge": false,
  "ignoreTests": false,
  "internalChecksAsSuccess": false,
  "minimumReleaseAge": "3 days",
  "minimumReleaseAgeBehaviour": "timestamp-optional",
  "separateMinorPatch": true,
  "prConcurrentLimit": 3,
  "prHourlyLimit": 2,
  "github-actions": {
    "pinDigests": true
  },
  "pip-compile": {
    "managerFilePatterns": [
      "requirements-dev.lock",
      "docs/reports/requirements-export.lock",
      "examples/ai/requirements.lock",
      "infra/cdc/requirements.lock",
      "infra/compute/requirements.lock",
      "infra/demo/requirements.lock",
      "infra/lakehouse/requirements.lock",
      "infra/mcp/requirements.lock",
      "infra/poc/requirements-notebooks.lock",
      "infra/poc/requirements-superset.lock"
    ],
    "constraints": {
      "uv": "==0.13.7"
    },
    "lockFileMaintenance": {
      "enabled": false
    }
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github\\/workflows\\/renovate\\.yml$/"],
      "matchStrings": [
        "RENOVATE_IMAGE: (?<depName>ghcr\\.io/renovatebot/renovate):(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "matchManagers": ["github-actions"],
      "matchDepTypes": ["!action", "!workflow"],
      "enabled": false
    },
    {
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "matchManagers": ["pip-compile"],
      "minimumReleaseAgeBehaviour": "timestamp-required",
      "automerge": false
    },
    {
      "description": "Update the SQL Server driver with the host and both container locks",
      "matchManagers": ["pip-compile"],
      "matchPackageNames": ["pymssql"],
      "enabled": false
    },
    {
      "description": "Update Spark, Notebook, and Sail client compatibility pins together",
      "matchManagers": ["pip-compile"],
      "matchFileNames": [
        "infra/compute/requirements.txt",
        "infra/poc/requirements-notebooks.txt"
      ],
      "matchPackageNames": ["numpy", "pandas", "pyarrow"],
      "enabled": false
    },
    {
      "description": "Automerge established patch releases of allowlisted CI actions after CI passes",
      "matchManagers": ["github-actions"],
      "matchDepTypes": ["action"],
      "matchPackageNames": [
        "actions/checkout",
        "actions/setup-python",
        "astral-sh/setup-uv"
      ],
      "matchUpdateTypes": ["patch"],
      "minimumReleaseAgeBehaviour": "timestamp-required",
      "automerge": true,
      "rebaseWhen": "behind-base-branch"
    }
  ]
}
