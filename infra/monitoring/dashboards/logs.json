{
  "uid": "lakehouse-logs-overview",
  "title": "Lakehouse Logs Overview",
  "schemaVersion": 41,
  "version": 1,
  "editable": true,
  "tags": [
    "lakehouse",
    "source-template"
  ],
  "timezone": "browser",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "title": "Events in five minutes",
      "type": "stat",
      "datasource": {
        "type": "loki",
        "uid": "foundation-loki"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({job=\"lakehouse\",compose_project=~\"$project\",compose_service=~\"$service\",container_name=~\"$container\",level=~\"$level\"} |= \"$keyword\"[5m]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "Per-service count",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "foundation-loki"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(compose_service) (count_over_time({job=\"lakehouse\",compose_project=~\"$project\",compose_service=~\"$service\",container_name=~\"$container\",level=~\"$level\"} |= \"$keyword\"[5m]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "Error/fatal rate",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "foundation-loki"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(compose_service) (rate({job=\"lakehouse\",compose_project=~\"$project\",compose_service=~\"$service\",container_name=~\"$container\",level=~\"error|fatal\"} |= \"$keyword\"[5m]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "Warnings in five minutes",
      "type": "stat",
      "datasource": {
        "type": "loki",
        "uid": "foundation-loki"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({job=\"lakehouse\",compose_project=~\"$project\",compose_service=~\"$service\",container_name=~\"$container\",level=\"warn\"} |= \"$keyword\"[5m]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "title": "Error/fatal in five minutes",
      "type": "stat",
      "datasource": {
        "type": "loki",
        "uid": "foundation-loki"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({job=\"lakehouse\",compose_project=~\"$project\",compose_service=~\"$service\",container_name=~\"$container\",level=~\"error|fatal\"} |= \"$keyword\"[5m]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "title": "Warning rate",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "foundation-loki"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(compose_service) (rate({job=\"lakehouse\",compose_project=~\"$project\",compose_service=~\"$service\",container_name=~\"$container\",level=\"warn\"} |= \"$keyword\"[5m]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "title": "Latest errors (selected project)",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "foundation-loki"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{job=\"lakehouse\",compose_project=~\"$project\",compose_service=~\"$service\",container_name=~\"$container\",level=~\"error|fatal\"} |= \"$keyword\""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "showTime": true,
        "enableLogDetails": true,
        "sortOrder": "Descending"
      }
    },
    {
      "id": 8,
      "title": "Selected logs",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "foundation-loki"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{job=\"lakehouse\",compose_project=~\"$project\",compose_service=~\"$service\",container_name=~\"$container\",level=~\"$level\"} |= \"$keyword\""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "showTime": true,
        "enableLogDetails": true,
        "sortOrder": "Descending"
      }
    },
    {
      "id": 9,
      "title": "Log acceptance pending",
      "type": "text",
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "mode": "markdown",
        "content": "Explicit level is preserved. Unknown remains unknown. Parser fixtures, backend delivery, redaction and GUI colors require separate validation. Counts are not exactly-once evidence."
      }
    }
  ],
  "templating": {
    "list": [
      {
        "name": "project",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "foundation-loki"
        },
        "query": "label_values({job=\"lakehouse\"},compose_project)",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "service",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "foundation-loki"
        },
        "query": "label_values({job=\"lakehouse\",compose_project=~\"$project\"},compose_service)",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "container",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "foundation-loki"
        },
        "query": "label_values({job=\"lakehouse\",compose_project=~\"$project\",compose_service=~\"$service\"},container_name)",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "level",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "foundation-loki"
        },
        "query": "label_values({job=\"lakehouse\",compose_project=~\"$project\",compose_service=~\"$service\",container_name=~\"$container\"},level)",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "keyword",
        "label": "Contains text",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        }
      }
    ]
  },
  "links": []
}
