{
  "uid": "lakehouse-operations",
  "title": "Lakehouse Operations",
  "schemaVersion": 41,
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Worker ready",
      "datasource": {
        "type": "prometheus",
        "uid": "foundation-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "expr": "lakehouse_ready",
          "refId": "A",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "textMode": "auto"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Successful jobs",
      "datasource": {
        "type": "prometheus",
        "uid": "foundation-prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "expr": "lakehouse_successful_runs",
          "refId": "A",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "textMode": "auto"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Failed jobs",
      "datasource": {
        "type": "prometheus",
        "uid": "foundation-prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "expr": "lakehouse_failed_runs",
          "refId": "A",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "textMode": "auto"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Imported files",
      "datasource": {
        "type": "prometheus",
        "uid": "foundation-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "expr": "lakehouse_imported_files",
          "refId": "A",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "textMode": "auto"
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Seconds since last success",
      "datasource": {
        "type": "prometheus",
        "uid": "foundation-prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 5,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "expr": "time() - lakehouse_last_success",
          "refId": "A",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "textMode": "auto"
      }
    }
  ],
  "editable": true
}
