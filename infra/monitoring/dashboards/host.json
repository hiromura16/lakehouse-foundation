{
  "uid": "lakehouse-host-overview",
  "title": "Lakehouse Host Overview",
  "schemaVersion": 41,
  "version": 1,
  "editable": true,
  "tags": [
    "lakehouse",
    "source-template"
  ],
  "timezone": "browser",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "title": "CPU used (%)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "foundation-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - avg by(instance) (rate(node_cpu_seconds_total{instance=~\"$instance\",mode=\"idle\"}[5m])))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "CPU modes",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "foundation-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(mode) (rate(node_cpu_seconds_total{instance=~\"$instance\"}[5m]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "Logical CPUs",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "foundation-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(node_cpu_seconds_total{instance=~\"$instance\",mode=\"idle\"})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "Load 1 / 5 / 15 minutes",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "foundation-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{__name__=~\"node_load1|node_load5|node_load15\",instance=~\"$instance\"}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "title": "Memory available",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "foundation-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "node_memory_MemAvailable_bytes{instance=~\"$instance\"}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "title": "Memory used",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "foundation-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "node_memory_MemTotal_bytes{instance=~\"$instance\"} - node_memory_MemAvailable_bytes{instance=~\"$instance\"}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "title": "Memory cache / buffers",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "foundation-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{__name__=~\"node_memory_Cached_bytes|node_memory_Buffers_bytes\",instance=~\"$instance\"}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "title": "Swap used",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "foundation-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "node_memory_SwapTotal_bytes{instance=~\"$instance\"} - node_memory_SwapFree_bytes{instance=~\"$instance\"}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "title": "Swap pages in/out per second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "foundation-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate({__name__=~\"node_vmstat_pswpin|node_vmstat_pswpout\",instance=~\"$instance\"}[5m])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      }
    },
    {
      "id": 10,
      "title": "Filesystem used (%)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "foundation-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - node_filesystem_avail_bytes{instance=~\"$instance\",fstype!~\"tmpfs|squashfs|overlay|nsfs|proc|sysfs|devtmpfs\"} / node_filesystem_size_bytes)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      }
    },
    {
      "id": 11,
      "title": "Filesystem available",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "foundation-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "node_filesystem_avail_bytes{instance=~\"$instance\",fstype!~\"tmpfs|squashfs|overlay|nsfs|proc|sysfs|devtmpfs\"}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      }
    },
    {
      "id": 12,
      "title": "Inodes used (%)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "foundation-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - node_filesystem_files_free{instance=~\"$instance\",fstype!~\"tmpfs|squashfs|overlay|nsfs|proc|sysfs|devtmpfs\"} / (node_filesystem_files > 0))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      }
    },
    {
      "id": 13,
      "title": "Disk read/write bytes",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "foundation-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 48,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate({__name__=~\"node_disk_read_bytes_total|node_disk_written_bytes_total\",instance=~\"$instance\"}[5m])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        },
        "overrides": []
      }
    },
    {
      "id": 14,
      "title": "Disk read/write operations",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "foundation-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 48,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate({__name__=~\"node_disk_reads_completed_total|node_disk_writes_completed_total\",instance=~\"$instance\"}[5m])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "iops"
        },
        "overrides": []
      }
    },
    {
      "id": 15,
      "title": "CPU iowait (%)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "foundation-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 56,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * avg(rate(node_cpu_seconds_total{instance=~\"$instance\",mode=\"iowait\"}[5m]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      }
    },
    {
      "id": 16,
      "title": "Uptime",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "foundation-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 56,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - node_boot_time_seconds{instance=~\"$instance\"}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 17,
      "title": "Processes",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "foundation-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 64,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "node_processes_pids{instance=~\"$instance\"}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 18,
      "title": "Network / TCP / systemd: out of scope",
      "type": "text",
      "gridPos": {
        "x": 12,
        "y": 64,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "mode": "markdown",
        "content": "Host root/PID access does not prove host network namespace access. Network/TCP and systemd collectors are deliberately disabled. No host-network or D-Bus permission is granted by this template."
      }
    }
  ],
  "templating": {
    "list": [
      {
        "name": "instance",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "foundation-prometheus"
        },
        "query": "label_values(node_cpu_seconds_total, instance)",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "links": [
    {
      "title": "Logs (same time range)",
      "url": "/d/lakehouse-logs-overview",
      "type": "link",
      "includeVars": true,
      "keepTime": true
    }
  ]
}
