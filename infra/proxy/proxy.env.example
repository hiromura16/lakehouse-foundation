# Daemon/client template: six legacy keys. site.env also stores canonical
# LAKEHOUSE_NO_PROXY; generate/upgrade it before Dokploy Environment import.
# Dokploy service proxy settings come from private site.env, not this file.
# Put DOKPLOY_BUILDKIT_NO_CLIENT_TOKEN=1 (or strict 0 to disable) in site.env.
# The daemon parser accepts only the six keys below; do not add that switch here.
# BuildKit client-token routing is an unverified workaround, not a guarantee.
# Values are literal; no shell expansion, quotes, whitespace or inline comments.
# Blank HTTP(S)_PROXY keeps the home/lab direct connection.
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1,::1,storage,catalog,catalog-db,trino,worker,catalog-migrate,n8n-db,n8n,prometheus,grafana,node-exporter,cadvisor,loki,vector,openobserve,sail-server,sail-benchmark,spark-volumes-init,spark-master,spark-worker,spark-history,spark-check,airflow-db,airflow,demo-api,demo,cdc-kafka,cdc-connect,cdc-ui,cdc-register,cdc-consumer,superset-db,superset-redis,superset-init,superset,jupyter,qdrant,marquez-db,marquez,marquez-web,mcp,dokploy,dokploy-postgres,dokploy-traefik
http_proxy=
https_proxy=
no_proxy=localhost,127.0.0.1,::1,storage,catalog,catalog-db,trino,worker,catalog-migrate,n8n-db,n8n,prometheus,grafana,node-exporter,cadvisor,loki,vector,openobserve,sail-server,sail-benchmark,spark-volumes-init,spark-master,spark-worker,spark-history,spark-check,airflow-db,airflow,demo-api,demo,cdc-kafka,cdc-connect,cdc-ui,cdc-register,cdc-consumer,superset-db,superset-redis,superset-init,superset,jupyter,qdrant,marquez-db,marquez,marquez-web,mcp,dokploy,dokploy-postgres,dokploy-traefik
