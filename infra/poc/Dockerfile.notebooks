# Spark 4.1 is the newest line with a published Iceberg 1.12 runtime.
FROM apache/spark:4.1.4-scala2.13-java21-python3-ubuntu@sha256:847f91f8bb2f28d632064dfe632d423020f8fd60b27c7704c0e5bf5b0c6432c7

COPY --from=ghcr.io/astral-sh/uv:0.13.7@sha256:96f40d3904aad8d0bd010539001d36c8e2188b981e1334471a90c4a1d93bb490 /uv /usr/local/bin/uv
ARG NOTEBOOK_UID=10001
ARG NOTEBOOK_GID=10001
USER root
COPY infra/proxy/install_ca.py /opt/lakehouse/install_ca.py
# Empty/unprovided secret is a no-op; proxy credentials never enter the image.
RUN --mount=type=secret,id=corporate_ca \
    python3 /opt/lakehouse/install_ca.py --ca-file /run/secrets/corporate_ca
ENV UV_SYSTEM_CERTS=true \
    SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt \
    REQUESTS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt \
    AWS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt \
    CURL_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt
RUN apt-get update \
    && apt-get install --no-install-recommends -y ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*

# Both artifacts are locked to the same Iceberg release. BuildKit's reserved
# proxy arguments apply to these downloads without entering image ENV layers.
RUN set -eu; \
    central=https://repo.maven.apache.org/maven2/org/apache/iceberg; \
    runtime=iceberg-spark-runtime-4.1_2.13; \
    bundle=iceberg-aws-bundle; \
    curl --fail --show-error --location --retry 3 \
      "$central/$runtime/1.12.0/$runtime-1.12.0.jar" \
      --output "/opt/spark/jars/$runtime-1.12.0.jar"; \
    printf '%s  %s\n' \
      ac1e2cb00970309f0c6bf241fabf334aef373c1f3e3b443181d429d5f2c0903ace47df9cfc1d55c95807a096cf405ae0a8868831b9e9eb5696dfdb6380587f38 \
      "/opt/spark/jars/$runtime-1.12.0.jar" | sha512sum --check -; \
    curl --fail --show-error --location --retry 3 \
      "$central/$bundle/1.12.0/$bundle-1.12.0.jar" \
      --output "/opt/spark/jars/$bundle-1.12.0.jar"; \
    printf '%s  %s\n' \
      b01456f80142c8837004e31329a0f40db8a9d44917a4a694cb7d8d6d3a68cb20c61e6f7788fa1bdcb95c0edf724322b49667d6f9ef60fc9cc46da5c24ce5c7de \
      "/opt/spark/jars/$bundle-1.12.0.jar" | sha512sum --check -

# A real passwd entry keeps Hadoop's local user identity valid.
RUN if ! getent group "$NOTEBOOK_GID" >/dev/null; then \
      groupadd --gid "$NOTEBOOK_GID" notebook; \
    fi \
    && usermod --uid "$NOTEBOOK_UID" --gid "$NOTEBOOK_GID" spark
ENV VIRTUAL_ENV=/opt/notebook-venv \
    PATH="/opt/notebook-venv/bin:$PATH" \
    PYTHONPATH=/opt/lakehouse:/opt/spark/python \
    HOME=/workspace PYTHONDONTWRITEBYTECODE=1 UV_PYTHON_DOWNLOADS=never
COPY infra/poc/requirements-notebooks.lock /opt/lakehouse/requirements.lock
RUN uv --system-certs --no-cache venv --python /usr/bin/python3 /opt/notebook-venv \
    && uv --system-certs --no-cache pip sync --python /opt/notebook-venv/bin/python \
      --require-hashes /opt/lakehouse/requirements.lock
COPY infra/poc/notebook_start.py /opt/lakehouse/notebook_start.py
COPY infra/poc/notebook_config.py /opt/lakehouse/notebook_config.py
COPY infra/poc/lakehouse_session.py /opt/lakehouse/lakehouse_session.py
COPY infra/poc/notebooks /opt/lakehouse/notebooks
ENV UV_OFFLINE=1 PYSPARK_PYTHON=/opt/notebook-venv/bin/python
WORKDIR /workspace
USER ${NOTEBOOK_UID}:${NOTEBOOK_GID}
CMD ["/opt/notebook-venv/bin/python", "/opt/lakehouse/notebook_start.py"]
